<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".SmartBudgetApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartBusget2"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">
        
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SmartBusget2">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <activity
            android:name=".ui.activities.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartBusget2" />
        
        <activity
            android:name=".ui.activities.RegisterActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartBusget2" />
        
        <activity
            android:name=".ui.activities.DashboardActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartBusget2" />
        
        <activity
            android:name=".ui.activities.TransactionsActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartBusget2"
            android:parentActivityName=".ui.activities.DashboardActivity" />
        
        <activity
            android:name=".ui.activities.AddTransactionActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartBusget2"
            android:parentActivityName=".ui.activities.TransactionsActivity" />
        
        <activity
            android:name=".ui.activities.AccountsActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartBusget2"
            android:parentActivityName=".ui.activities.DashboardActivity" />
        
        <activity
            android:name=".ui.activities.AddAccountActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartBusget2"
            android:parentActivityName=".ui.activities.AccountsActivity" />
        
        <activity
            android:name=".ui.activities.BudgetsActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartBusget2"
            android:parentActivityName=".ui.activities.DashboardActivity" />
        
        <activity
            android:name=".ui.activities.AddBudgetActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartBusget2"
            android:parentActivityName=".ui.activities.BudgetsActivity" />
        
        <activity
            android:name=".ui.activities.CategoriesActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartBusget2"
            android:parentActivityName=".ui.activities.DashboardActivity" />
        
        <activity
            android:name=".ui.activities.AnalyticsActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartBusget2"
            android:parentActivityName=".ui.activities.DashboardActivity" />

        <activity
            android:name=".ui.activities.AddCategoryActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartBusget2"
            android:parentActivityName=".ui.activities.CategoriesActivity" />
    </application>

</manifest>